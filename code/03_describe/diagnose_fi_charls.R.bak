# Full diagnostic audit for the CHARLS 2011 43-item frailty index.
options(stringsAsFactors = FALSE, warn = 1)
suppressPackageStartupMessages(library(arrow))
args <- commandArgs(FALSE)
f <- grep('^--file=', args, value = TRUE)
script_path <- if (length(f)) sub('^--file=', '', f[1]) else 'code/03_describe/diagnose_fi_charls.R'
root <- normalizePath(file.path(dirname(script_path), '../..'), mustWork = TRUE)
fi_path <- file.path(root, 'data', 'analysis', 'charls_fi_2011_2026-07-27.parquet')
res_dir <- file.path(root, 'results', 'fi_charls')
tab_dir <- file.path(res_dir, 'tables')
fig_dir <- file.path(res_dir, 'figures')
log_dir <- file.path(root, 'logs')
dir.create(tab_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(log_dir, recursive = TRUE, showWarnings = FALSE)
logc <- file(file.path(log_dir, 'diagnose_fi_charls_2026-07-28.log'), 'wt', encoding = 'UTF-8')
sink(logc, type = 'output'); sink(logc, type = 'message')
finish <- function() { sink(type = 'message'); sink(type = 'output'); close(logc) }
on.exit(finish(), add = TRUE)
say <- function(...) cat(format(Sys.time(), '[%Y-%m-%d %H:%M:%S]'), ..., '\n')
ok <- function(x, msg) { if (!isTRUE(x)) stop('ASSERTION FAILED: ', msg); say('PASS:', msg) }
ok(file.exists(fi_path), 'FI parquet exists')
dat <- as.data.frame(read_parquet(fi_path))
names43 <- c('hibpe','diabe','cancre','lunge','hearte','stroke','psyche','arthre','dyslipe','livere','kidneye','digeste','asthmae','dressa','batha','eata','beda','toilta','urina','moneya','medsa','shopa','mealsa','housewka','walk100a','walk1kma','joga','climsa','chaira','stoopa','armsa','lifta','dimea','dsight','nsight','hearing','shlt','painfr','fall','hlthlm_c','slfmem','mbmi','hearaid')
ok(nrow(dat) == 17705, 'FI rows = 17705')
ok(length(names43) == 43 && all(names43 %in% names(dat)), 'all 43 deficit columns exist')
ok(!anyDuplicated(dat$id), 'FI IDs unique')
binary <- c('hibpe','diabe','cancre','lunge','hearte','stroke','psyche','arthre','dyslipe','livere','kidneye','digeste','asthmae','dressa','batha','eata','beda','toilta','urina','moneya','medsa','shopa','mealsa','housewka','walk100a','walk1kma','joga','climsa','chaira','stoopa','armsa','lifta','dimea','painfr','fall','hlthlm_c','mbmi','hearaid')
age_group <- cut(dat$age, breaks = c(45,60,70,80,Inf), right = FALSE, labels = c('45-59','60-69','70-79','80+'))
diag <- data.frame(item = names43, type = ifelse(names43 %in% binary, 'binary', 'ordinal_or_continuous'), missing_n = NA_integer_, missing_rate = NA_real_, overall_rate_or_mean = NA_real_, age_60_69 = NA_real_, age_70_79 = NA_real_, age_80_plus = NA_real_, criterion_3 = NA_character_, criterion_2 = NA_character_)
for (i in seq_along(names43)) {
  nm <- names43[i]; x <- as.numeric(dat[[nm]])
  diag$missing_n[i] <- sum(is.na(x)); diag$missing_rate[i] <- mean(is.na(x)); diag$overall_rate_or_mean[i] <- mean(x, na.rm = TRUE)
  for (g in c('60-69','70-79','80+')) { z <- x[age_group == g]; diag[i, paste0('age_', gsub('-', '_', g))] <- mean(z, na.rm = TRUE) }
  diag$criterion_3[i] <- if (nm %in% binary) ifelse(diag$overall_rate_or_mean[i] < .01, 'VIOLATES_CRITERION_3', 'PASS') else 'NOT_APPLICABLE_ORDINAL'
  vals <- as.numeric(diag[i, c('age_60_69','age_70_79','age_80_plus')]); vals <- vals[is.finite(vals)]
  diag$criterion_2[i] <- if (length(vals) < 2) 'INSUFFICIENT_AGE_DATA' else if (all(diff(vals) >= -1e-12)) 'PASS_MONOTONIC' else 'VIOLATES_CRITERION_2'
}
write.csv(diag, file.path(tab_dir, 'fi_item_availability_age_gradient.csv'), row.names = FALSE, na = '')

rank_corr <- function(a, b) { q <- complete.cases(a,b); if (sum(q) < 3) return(NA_real_); suppressWarnings(cor(a[q], b[q], method = 'spearman')) }
cm <- matrix(NA_real_, 43, 43, dimnames = list(names43, names43))
for (i in seq_along(names43)) for (j in i:seq_along(names43)) { r <- rank_corr(as.numeric(dat[[names43[i]]]), as.numeric(dat[[names43[j]]])); cm[i,j] <- r; cm[j,i] <- r }
write.csv(cm, file.path(tab_dir, 'fi_item_correlation_matrix.csv'), row.names = TRUE, na = '')
pairs <- data.frame(item_1 = character(), item_2 = character(), correlation = numeric(), abs_correlation = numeric())
for (i in 1:42) for (j in (i+1):43) if (is.finite(cm[i,j]) && abs(cm[i,j]) > .85) pairs <- rbind(pairs, data.frame(item_1=names43[i], item_2=names43[j], correlation=cm[i,j], abs_correlation=abs(cm[i,j])))
write.csv(pairs, file.path(tab_dir, 'fi_high_correlation_pairs_abs_gt_0.85.csv'), row.names = FALSE, na = '')
focus <- data.frame(group = c('mobility_walk_jog','mobility_walk_jog','mobility_walk_jog','sensory_vision'), item_1 = c('walk100a','walk100a','walk1kma','dsight'), item_2 = c('walk1kma','joga','joga','nsight'), correlation = c(cm['walk100a','walk1kma'],cm['walk100a','joga'],cm['walk1kma','joga'],cm['dsight','nsight']))
adl <- c('dressa','batha','eata','beda','toilta','urina'); for (i in 1:5) for (j in (i+1):6) focus <- rbind(focus, data.frame(group='adl_internal', item_1=adl[i], item_2=adl[j], correlation=cm[adl[i],adl[j]]))
write.csv(focus, file.path(tab_dir, 'fi_focus_correlations.csv'), row.names = FALSE)

skewness <- function(x) { x <- x[is.finite(x)]; if (length(x) < 3) return(NA_real_); s <- sd(x); if (!is.finite(s) || s == 0) return(0); mean((x-mean(x))^3)/(s^3) }
dist <- data.frame(sample=c('all','age_60_plus'), n=NA_integer_, fi_n_valid_median=NA_real_, fi_median=NA_real_, fi_mean=NA_real_, fi_p95=NA_real_, fi_max=NA_real_, fi_ge_0_7_n=NA_integer_, fi_ge_0_7_rate=NA_real_, skewness=NA_real_, age_spearman=NA_real_)
for (k in 1:2) { keep <- if (k == 1) rep(TRUE,nrow(dat)) else dat$age >= 60; x <- dat$fi_full[keep]; x <- x[is.finite(x)]; dist$n[k] <- length(x); dist$fi_n_valid_median[k] <- median(dat$fi_n_valid[keep],na.rm=TRUE); dist$fi_median[k] <- median(x); dist$fi_mean[k] <- mean(x); dist$fi_p95[k] <- as.numeric(quantile(x,.95)); dist$fi_max[k] <- max(x); dist$fi_ge_0_7_n[k] <- sum(x >= .7); dist$fi_ge_0_7_rate[k] <- mean(x >= .7); dist$skewness[k] <- skewness(x); dist$age_spearman[k] <- if(k==1) rank_corr(dat$fi_full,dat$age) else rank_corr(dat$fi_full[dat$age>=60],dat$age[dat$age>=60]) }
write.csv(dist, file.path(tab_dir, 'fi_distribution_summary.csv'), row.names = FALSE, na = '')

png(file.path(fig_dir, 'fi_histogram_all_and_60plus.png'), 1800, 850, res=150); par(mfrow=c(1,2),mar=c(4,4,3,1)); hist(dat$fi_full,breaks=30,main='FI: all eligible',xlab='FI',col='#4C78A8',border='white'); hist(dat$fi_full[dat$age>=60],breaks=30,main='FI: age 60+',xlab='FI',col='#F58518',border='white'); dev.off()
png(file.path(fig_dir, 'fi_boxplot_age_groups.png'), 1200, 900, res=150); boxplot(fi_full ~ age_group, data=data.frame(fi_full=dat$fi_full,age_group=age_group), xlab='Age group', ylab='FI', main='FI by age group', col='#72B7B2'); dev.off()
keep <- is.finite(dat$fi_full) & is.finite(dat$age); png(file.path(fig_dir, 'fi_vs_age_loess.png'),1200,900,res=150); plot(dat$age[keep],dat$fi_full[keep],pch=16,cex=.25,col=rgb(0,0,0,.2),xlab='Age',ylab='FI',main='FI vs age with LOESS'); if(sum(keep)>20){ fit <- loess(fi_full ~ age,data=data.frame(fi_full=dat$fi_full[keep],age=dat$age[keep])); xx <- seq(min(dat$age[keep]),max(dat$age[keep]),length.out=200); lines(xx,predict(fit,newdata=data.frame(age=xx)),col='#E45756',lwd=2) }; dev.off()
means <- colMeans(dat[,names43],na.rm=TRUE); ord <- order(means); png(file.path(fig_dir, 'fi_item_rate_barplot.png'),1500,1300,res=150); par(mar=c(5,10,3,1)); barplot(means[ord],horiz=TRUE,las=1,names.arg=names(means)[ord],col='#54A24B',xlab='Mean deficit / positive rate',main='43 FI items'); dev.off()
png(file.path(fig_dir, 'fi_correlation_heatmap.png'),1500,1400,res=150); par(mar=c(8,8,3,1)); image(1:43,1:43,cm[43:1,],axes=FALSE,col=colorRampPalette(c('#3B4CC0','white','#B40426'))(100),zlim=c(-1,1),main='Correlation matrix'); axis(1,at=1:43,labels=names43,las=2,cex.axis=.45); axis(2,at=1:43,labels=rev(names43),las=2,cex.axis=.45); box(); dev.off()
png(file.path(fig_dir, 'fi_valid_items_distribution.png'),1200,900,res=150); hist(dat$fi_n_valid,breaks=seq(min(dat$fi_n_valid,na.rm=TRUE)-.5,max(dat$fi_n_valid,na.rm=TRUE)+.5,1),main='Valid FI items per person',xlab='Valid deficit items',col='#B279A2',border='white'); abline(v=35,col='#E45756',lwd=2,lty=2); dev.off()
flag3 <- diag[diag$criterion_3 == 'VIOLATES_CRITERION_3', c('item','overall_rate_or_mean','missing_rate')]; flag2 <- diag[diag$criterion_2 == 'VIOLATES_CRITERION_2', c('item','age_60_69','age_70_79','age_80_plus')]; write.csv(flag3,file.path(tab_dir,'criterion_3_flags.csv'),row.names=FALSE); write.csv(flag2,file.path(tab_dir,'criterion_2_flags.csv'),row.names=FALSE)
report <- file(file.path(res_dir,'fi_diagnostic_report_2026-07-27.md'),'wt',encoding='UTF-8')
writeLines(c('# CHARLS 2011 FI diagnostic report','', 'This report audits the 43-item Gateway-aligned FI. Raw files were read only. No mortality, IC, association, or model analysis was performed.','',paste0('- Rows: ',nrow(dat),'; FI eligible (>=35 valid): ',sum(!is.na(dat$fi_full)),'; excluded: ',sum(dat$fi_excluded)),paste0('- Items with missingness >30%: ',if(nrow(diag[diag$missing_rate>.30,])==0)'none' else paste(diag$item[diag$missing_rate>.30],collapse=', ')),paste0('- Criterion 3 flags: ',if(nrow(flag3)==0)'none' else paste(flag3$item,collapse=', ')),paste0('- Criterion 2 flags: ',if(nrow(flag2)==0)'none' else paste(flag2$item,collapse=', ')),paste0('- High-correlation pairs |r|>0.85: ',nrow(pairs)),paste0('- `joga`: ',if(any(pairs$item_1=='joga'|pairs$item_2=='joga'))'review for redundancy' else 'no high-correlation pair; retain'),'', 'Distribution summary is in tables/fi_distribution_summary.csv. Item-level results are in tables/fi_item_availability_age_gradient.csv. Full and focused correlation outputs are in tables/.', '', 'Figures are in figures/.', '', 'Build and diagnostic assertions passed.'),report); close(report)
say('Diagnostic complete')
